PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/trawiller
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
ACCESS_TOKEN_SECRET=trawiller_access_token_secret_key_change_in_prod_12345
